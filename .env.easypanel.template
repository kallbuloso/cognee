###############################################################################
# COGNEE — EASYPANEL STACK TEMPLATE
# Pré-configurado para: OpenRouter · Wasabi S3 · PostgreSQL/PGVector · Neo4j · Redis
#
# 1. Copie este arquivo para .env
# 2. Preencha TODOS os valores marcados com <CHANGE_ME>
# 3. Revise os demais valores e ajuste conforme necessário
###############################################################################


###############################################################################
# TIER 1 — LLM (OpenRouter)
###############################################################################

# Chave de API do OpenRouter: https://openrouter.ai/keys
LLM_API_KEY="<CHANGE_ME>"

LLM_PROVIDER="custom"
LLM_MODEL="openrouter/deepseek/deepseek-v4-pro"
LLM_ENDPOINT="https://openrouter.ai/api/v1"

# Ajuste se quiser limitar o contexto (o padrão é seguro)
#LLM_MAX_TOKENS="16384"

# Rate limiting (recomendado para OpenRouter)
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=60
LLM_RATE_LIMIT_INTERVAL=60

# Structured output via instructor (padrão, funciona bem com modelos OpenRouter)
STRUCTURED_OUTPUT_FRAMEWORK="instructor"
#LLM_INSTRUCTOR_MODE=""


###############################################################################
# TIER 1 — EMBEDDING (OpenRouter → OpenAI text-embedding-3-large)
###############################################################################

EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="openrouter/openai/text-embedding-3-large"
EMBEDDING_ENDPOINT="https://openrouter.ai/api/v1"
EMBEDDING_DIMENSIONS=3072
EMBEDDING_MAX_TOKENS=8191
EMBEDDING_BATCH_SIZE=36

# Usa a mesma LLM_API_KEY se não informada
#EMBEDDING_API_KEY="<CHANGE_ME_se_diferente_da_LLM_API_KEY>"


###############################################################################
# TIER 2 — BANCO RELACIONAL (PostgreSQL + PGVector)
###############################################################################

DB_PROVIDER="postgres"
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cognee_db
DB_USERNAME=cognee
DB_PASSWORD="<CHANGE_ME>"

# Tuning de pool (ajuste conforme carga esperada)
#POOL_ARGS='{"pool_size": 5, "max_overflow": 10, "pool_recycle": 3600, "pool_timeout": 30}'


###############################################################################
# TIER 2 — BANCO VETORIAL (PGVector — mesmo Postgres acima)
###############################################################################

VECTOR_DB_PROVIDER="pgvector"
# Usa as mesmas credenciais do DB_* acima; não é necessário VECTOR_DB_URL separado
# quando host/port/name/user/pass são herdados do bloco DB_* pelo adaptador pgvector.
# Caso o adaptador exija URL explícita:
#VECTOR_DB_URL="postgresql://cognee:<CHANGE_ME>@postgres:5432/cognee_db"


###############################################################################
# TIER 2 — BANCO DE GRAFOS (Neo4j)
###############################################################################

GRAPH_DATABASE_PROVIDER="neo4j"
GRAPH_DATABASE_URL=bolt://neo4j:7687
GRAPH_DATABASE_NAME="neo4j"
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD="<CHANGE_ME>"


###############################################################################
# TIER 2 — ARMAZENAMENTO DE ARQUIVOS (Wasabi S3)
###############################################################################

STORAGE_BACKEND="s3"
STORAGE_BUCKET_NAME="<CHANGE_ME>"             # nome do seu bucket no Wasabi

# Credenciais Wasabi
AWS_ACCESS_KEY_ID="<CHANGE_ME>"
AWS_SECRET_ACCESS_KEY="<CHANGE_ME>"
AWS_REGION="<CHANGE_ME>"                      # ex: us-east-1, eu-central-1
# Endpoint S3-compatible do Wasabi (obrigatório!)
AWS_ENDPOINT_URL="https://s3.wasabisys.com"   # ou endpoint regional, ex: https://s3.eu-central-1.wasabisys.com

# Prefixos dentro do bucket
DATA_ROOT_DIRECTORY="s3://<CHANGE_ME>/cognee/data"
SYSTEM_ROOT_DIRECTORY="s3://<CHANGE_ME>/cognee/system"
CACHE_ROOT_DIRECTORY="s3://<CHANGE_ME>/cognee/cache"


###############################################################################
# TIER 2 — CACHE (Redis)
###############################################################################

CACHING=true
CACHE_BACKEND=redis
REDIS_URL="redis://redis:6379/0"


###############################################################################
# TIER 2 — MIGRAÇÃO (Postgres — mesmo servidor do DB acima)
###############################################################################

MIGRATION_DB_PROVIDER="postgres"
MIGRATION_DB_HOST=postgres
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=cognee_db
MIGRATION_DB_USERNAME=cognee
MIGRATION_DB_PASSWORD="<CHANGE_ME>"           # mesmo valor de DB_PASSWORD


###############################################################################
# TIER 3 — PERFORMANCE
###############################################################################

# Quantas instâncias de DB engine ficam em cache LRU simultâneo
DATABASE_MAX_LRU_CACHE_SIZE=6

# Fila de datasets — evita sobrecarga quando muitos datasets processam em paralelo
DATASET_QUEUE_ENABLED=true
DATASET_QUEUE_MAX_CONCURRENT=6


###############################################################################
# TIER 3 — ONTOLOGIA
###############################################################################

# Habilitar ontologia para grounding das extrações
ONTOLOGY_RESOLVER=rdflib
MATCHING_STRATEGY=fuzzy
# Caminho do arquivo OWL (dentro do container ou no S3)
#ONTOLOGY_FILE_PATH=/app/ontology/sua_ontologia.owl


###############################################################################
# TIER 3 — TRADUÇÃO
###############################################################################

TRANSLATION_PROVIDER="llm"
TARGET_LANGUAGE="pt_BR"
CONFIDENCE_THRESHOLD=0.8
#TRANSLATION_BATCH_SIZE=10
#TRANSLATION_MAX_RETRIES=3
#TRANSLATION_TIMEOUT_SECONDS=30


###############################################################################
# TIER 3 — SEGURANÇA & AUTENTICAÇÃO
###############################################################################

# Gere um segredo forte: python -c "import secrets; print(secrets.token_hex(32))"
FASTAPI_USERS_JWT_SECRET="<CHANGE_ME>"
JWT_LIFETIME_SECONDS=3600

HASH_API_KEY="True"

# Modo single-user (shared DB) com autenticação obrigatória via token
ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=true

# Segurança de endpoint
ACCEPT_LOCAL_FILE_PATH=False
ALLOW_HTTP_REQUESTS=True
ALLOW_CYPHER_QUERY=True
RAISE_INCREMENTAL_LOADING_ERRORS=True

# ---------------------------------------------------------------------------
# Usuário administrador padrão — criado automaticamente na primeira execução
# como superusuário (is_superuser=True, is_active=True, is_verified=True).
# Altere estes valores antes de subir a stack pela primeira vez.
# ---------------------------------------------------------------------------
DEFAULT_USER_EMAIL="<CHANGE_ME>"              # ex: admin@seudominio.com
DEFAULT_USER_PASSWORD="<CHANGE_ME>"

# ---------------------------------------------------------------------------
# ⚠️  BLOQUEIO DE REGISTRO DE NOVOS USUÁRIOS
#
# O Cognee NÃO possui variável de ambiente nativa para desabilitar o endpoint
# de registro público (POST /api/v1/auth/register).
# Com ENABLE_BACKEND_ACCESS_CONTROL=false (modo single-user), qualquer pessoa
# que consiga acessar esse endpoint poderia criar uma conta com acesso aos dados.
#
# MITIGAÇÃO OBRIGATÓRIA no Easypanel:
#   Configure uma regra no proxy reverso do serviço "cognee" para bloquear
#   (retornar 403/404) requisições para o caminho:
#
#       POST /api/v1/auth/register
#
#   No Easypanel (Traefik), isso pode ser feito via middleware de rota ou
#   regra de redirecionamento nas configurações avançadas do serviço.
#   Enquanto a regra não estiver ativa, CORS_ALLOWED_ORIGINS abaixo deve
#   ser restrito ao(s) domínio(s) confiável(is) como primeira barreira.
# ---------------------------------------------------------------------------


###############################################################################
# TIER 3 — CORS / REDE
###############################################################################

# ⚠️  Em produção, substitua '*' pelo domínio real do seu cliente MCP / API
# gateway. Isso é especialmente importante enquanto o endpoint de registro
# não estiver bloqueado no proxy.
CORS_ALLOWED_ORIGINS="https://<SEU_DOMINIO>"


###############################################################################
# TIER 3 — LOGS & OBSERVABILIDADE
###############################################################################

ENV="production"
LOG_LEVEL=INFO
LITELLM_LOG="ERROR"
TOKENIZERS_PARALLELISM="false"
#COGNEE_LOG_SEARCH_HISTORY="true"
#COGNEE_LOG_FILE="true"
#COGNEE_LOGS_DIR="/var/log/cognee"
#COGNEE_LOG_MAX_BYTES=52428800
#COGNEE_LOG_BACKUP_COUNT=5

# OpenTelemetry (descomente para ativar tracing)
#COGNEE_TRACING_ENABLED=true
#OTEL_EXPORTER_OTLP_ENDPOINT="https://seu-backend-otel:4317"
#OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <token>"
#OTEL_SERVICE_NAME="cognee"

# Telemetria interna (descomente para desabilitar)
#TELEMETRY_DISABLED=1


###############################################################################
# TIER 3 — WEB SCRAPER
###############################################################################

WEB_SCRAPER_TIMEOUT=15.0
WEB_SCRAPER_MAX_DELAY=10.0


###############################################################################
# NÃO USADO NESTA STACK
# Cloud Sync, UI frontend e DLT estão desabilitados
###############################################################################

# COGNEE_CLOUD_API_URL=   # não usar Cloud Sync
# COGNEE_CLOUD_AUTH_TOKEN=
# UI_APP_URL=             # sem frontend nesta stack
# DLT_MAX_ROWS_PER_TABLE=
